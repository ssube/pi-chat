{
  "agent": "example_agent",
  "work_dir": "/workspace",
  "state_dir": "/state/bridge",
  "pi_executable": "/usr/local/bin/pi",
  "pi_agent_dir": "/state/pi",
  "provider": "configured-provider",
  "model": "configured-model",
  "pi_pass_env": [],
